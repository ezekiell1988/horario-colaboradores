generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String
  rol           String       // "admin" | "oficial"
  colaboradorId String?      @unique
  colaborador   Colaborador? @relation(fields: [colaboradorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  informes      Informe[]

  @@map("User")
}

model Colaborador {
  id                   String          @id @default(cuid())
  nombre               String
  puesto               String?         @db.NVarChar(100)
  modalidad            String          @default("FULL") @db.NVarChar(15) // "FULL" | "MT" | "FIJO" | "MT_ALTERNO"
  turnoFijo            String?         @db.NVarChar(10)
  fechaInicioPersonal  DateTime?       // solo MT_ALTERNO: lunes de referencia del ciclo propio
  diaLibre             String?         @db.NVarChar(10) // "LUNES"|"MARTES"|"MIERCOLES"|"JUEVES"|"VIERNES"|"SABADO"|"DOMINGO"
  diaLibreExtra        String?         @db.NVarChar(10) // segundo día libre opcional (ej. FULL en T3)
  activo               Boolean         @default(true)
  grupoId              String
  grupo                Grupo           @relation(fields: [grupoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  asistencias          Asistencia[]
  excepciones          ExcepcionRoll[]
  user                 User?

  @@map("Colaborador")
}

model Grupo {
  id                  String        @id @default(cuid())
  nombre              String
  turnoInicioIndex    Int           // 0=T1, 1=T2, 2=T3
  fechaInicioRotacion DateTime
  colaboradores       Colaborador[]

  @@map("Grupo")
}

model Asistencia {
  id            String      @id @default(cuid())
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fecha         DateTime
  turno         String      // "T1" | "T2" | "T3"
  puesto        String
  estado        String      // "presente" | "ausente" | "permiso"

  @@unique([colaboradorId, fecha])
  @@map("Asistencia")
}

model Informe {
  id           String   @id @default(cuid())
  fecha        DateTime
  titulo       String
  contenido    String   @db.NVarChar(Max)
  textoFormal  String?  @db.NVarChar(Max)
  pdfUrl       String?
  creadoPor    String
  creadoBy     User     @relation(fields: [creadoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creadoAt     DateTime @default(now())

  @@map("Informe")
}

model ExcepcionRoll {
  id            String      @id @default(cuid())
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  semana        DateTime    // lunes de la semana (UTC 00:00:00)
  tipo          String      // "vacaciones" | "permiso" | "ausencia"
  nota          String?

  @@unique([colaboradorId, semana])
  @@map("ExcepcionRoll")
}

/// Datos crudos importados del PDF de programación (Detalle de la programación)
model ProgramacionPDF {
  id             String   @id @default(cuid())
  puestoNum      String   @db.NVarChar(10)
  puestoNombre   String   @db.NVarChar(200)
  fecha          DateTime
  codigoOficial  String   @db.NVarChar(20)
  nombreOficial  String   @db.NVarChar(150)
  horaEntrada    String?  @db.NVarChar(5)
  horaSalida     String?  @db.NVarChar(5)
  turno          String?  @db.NVarChar(10)  // T1 | T2 | T3 | T_ADMIN
  ausentismo     String   @db.NVarChar(20)  // Normal | Libre
  pagina         Int

  @@index([codigoOficial])
  @@index([fecha])
  @@map("ProgramacionPDF")
}
